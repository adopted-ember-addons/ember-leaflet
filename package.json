{
  "name": "ember-leaflet",
  "version": "6.0.0",
  "description": "Easy and declarative mapping for ember.",
  "keywords": [
    "ember-addon",
    "leaflet",
    "ember",
    "ember-leaflet",
    "mapping",
    "maps"
  ],
  "homepage": "https://adopted-ember-addons.github.io/ember-leaflet/",
  "repository": "https://github.com/adopted-ember-addons/ember-leaflet",
  "license": "MIT",
  "author": "Miguel Andrade <jmandrade0@gmail.com>",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "ember build --environment=production",
    "deploy": "ember deploy production",
    "eslint-all": "eslint --fix \"**/*.js\"",
    "eslint-config-check": "eslint --print-config . | eslint-config-prettier-check",
    "format": "prettier . --cache --write",
    "format-all": "npm run prettier-all && npm run eslint-all",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:deps": "ember dependency-lint",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:scss": "stylelint \"**/*.scss\"",
    "lint:scss:fix": "concurrently \"npm:lint:scss -- --fix\"",
    "prettier-all": "prettier --write \"**/*.{js,scss,json,yaml,yml}\"",
    "start": "ember serve",
    "test": "concurrently \"pnpm:lint\" \"pnpm:test:*\" --names \"lint,test:\" --prefixColors auto",
    "test:ember": "ember test",
    "test:ember-compatibility": "ember try:each"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,scss,json,yaml,yml,md}": [
      "prettier --write",
      "git add"
    ],
    "*.js": [
      "eslint --fix",
      "git add"
    ]
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-class-static-block": "^7.29.7",
    "broccoli-funnel": "^3.0.8",
    "broccoli-merge-trees": "^4.2.0",
    "ember-auto-import": "^2.13.1",
    "ember-cli-babel": "^8.3.1",
    "ember-cli-htmlbars": "^7.0.1",
    "ember-composability-tools": "^2.0.0",
    "ember-render-helpers": "^0.2.1 || ^1.0.0 || ^3.0.0",
    "ember-template-imports": "^4.4.0",
    "fastboot-transform": "^0.1.3",
    "resolve": "^1.21.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@ember/optional-features": "^3.0.0",
    "@ember/string": "^4.0.0",
    "@ember/test-helpers": "^5.4.1",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/macros": "^1.20.2",
    "@embroider/test-setup": "^4.0.0",
    "@eslint/js": "^9.39.4",
    "@glimmer/component": "^1.1.2",
    "@glimmer/tracking": "^1.1.2",
    "broccoli-asset-rev": "^3.0.0",
    "concurrently": "^10.0.0",
    "ember-cli": "~7.1.0",
    "ember-cli-addon-docs": "^11.0.0",
    "ember-cli-addon-docs-yuidoc": "^1.0.0",
    "ember-cli-clean-css": "^3.0.0",
    "ember-cli-dependency-checker": "^3.4.0",
    "ember-cli-dependency-lint": "^2.0.1",
    "ember-cli-deploy": "^2.0.0",
    "ember-cli-deploy-build": "^3.0.0",
    "ember-cli-deploy-git": "^1.3.4",
    "ember-cli-deprecation-workflow": "^3.4.0",
    "ember-cli-favicon": "^3.0.0",
    "ember-cli-inject-live-reload": "^2.1.0",
    "ember-cli-sass": "^11.0.0",
    "ember-cli-sri": "^2.1.1",
    "ember-cli-terser": "^4.0.2",
    "ember-leaflet-marker-cluster": "^1.1.1",
    "ember-load-initializers": "^3.0.1",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.0.4",
    "ember-resolver": "^13.2.0",
    "ember-source": "~6.12.0",
    "ember-source-channel-url": "^3.0.0",
    "ember-template-lint": "^7.0.0",
    "ember-try": "^4.0.0",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-ember": "^13.0.0",
    "eslint-plugin-n": "^18.0.0",
    "eslint-plugin-qunit": "^8.1.2",
    "globals": "^17.0.0",
    "leaflet": "^1.9.4",
    "loader.js": "^4.7.0",
    "prettier": "^3.8.1",
    "prettier-plugin-ember-template-tag": "^2.1.4",
    "qunit": "^2.25.0",
    "qunit-dom": "^3.5.0",
    "release-plan": "^0.18.0",
    "sass": "^1.49.7",
    "stylelint": "^17.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "webpack": "^5.106.0"
  },
  "peerDependencies": {
    "ember-source": ">= 4.12.0",
    "leaflet": ">= 1.0"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "engines": {
    "node": "22 || 24 || >= 26"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "configPath": "tests/dummy/config",
    "demoURL": "https://adopted-ember-addons.github.io/ember-leaflet/"
  },
  "fastbootDependencies": [
    "crypto"
  ]
}
